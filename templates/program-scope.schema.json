{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Program Scope Profile Draft",
  "type":"object",
  "required":["profile_version","status","operator_confirmation_required","source","source_sha256","program_name","assets_in_scope","out_of_scope","prohibited_methods","rate_limits","testing_windows","data_handling","safe_harbor","bounty_eligibility","ambiguities","evidence"],
  "properties":{
    "profile_version":{"const":1},
    "status":{"const":"draft_unverified"},
    "operator_confirmation_required":{"const":true},
    "source":{"type":"string","minLength":1},
    "source_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "program_name":{"type":["string","null"]},
    "assets_in_scope":{"type":"array","items":{"type":"string"}},
    "out_of_scope":{"type":"array","items":{"type":"string"}},
    "prohibited_methods":{"type":"array","items":{"type":"string"}},
    "rate_limits":{"type":"array","items":{"type":"string"}},
    "testing_windows":{"type":"array","items":{"type":"string"}},
    "data_handling":{"type":"array","items":{"type":"string"}},
    "safe_harbor":{"type":["string","null"]},
    "bounty_eligibility":{"type":["string","null"]},
    "ambiguities":{"type":"array","items":{"type":"string"}},
    "evidence":{"type":"array","items":{"type":"object","required":["field","section","quote","line"],"properties":{
      "field":{"type":"string"},"section":{"type":"string"},"quote":{"type":"string","minLength":1},"line":{"type":"integer","minimum":1}
    },"additionalProperties":false}}
  },
  "additionalProperties":false
}
