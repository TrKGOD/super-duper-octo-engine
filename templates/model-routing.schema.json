{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model Routing Policy",
  "type": "object",
  "properties": {
    "default_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "escalation_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "escalate_on": {
      "type": "array",
      "items": {
        "enum": [
          "invalid_output",
          "repeated_inconclusive",
          "high_complexity"
        ]
      },
      "uniqueItems": true
    },
    "max_escalations": {
      "enum": [
        0,
        1
      ]
    }
  },
  "additionalProperties": false
}
